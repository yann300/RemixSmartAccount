{
  "script-runner": {
    "defaultConfig": "ethers6",
    "customConfig": {
      "baseConfiguration": "default",
      "dependencies": []
    }
  },
  "project": "introToEIP7702",
  "version": "1.2.0",
  "IDE": "remix.ethereum.org",
  "solidity-compiler": {
    "language": "Solidity",
    "settings": {
      "optimizer": {
        "enabled": true,
        "runs": 200
      },
      "outputSelection": {
        "*": {
          "": [
            "ast"
          ],
          "*": [
            "abi",
            "metadata",
            "devdoc",
            "userdoc",
            "storageLayout",
            "evm.legacyAssembly",
            "evm.bytecode",
            "evm.deployedBytecode",
            "evm.methodIdentifiers",
            "evm.gasEstimates",
            "evm.assembly"
          ]
        }
      }
    }
  }
}